APP_NAME=bowfishIQ
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password

# Fish counting: add your key to .env and restart the server.
OPENAI_API_KEY=
OPENAI_FISH_MODEL=gpt-5.6-sol

# AI trip analysis uses the same OPENAI_API_KEY, independently of fish counting.
OPENAI_TRIP_ANALYSIS_MODEL=gpt-4.1

# Set a real application contact for weather.gov requests.
NWS_USER_AGENT=BowfishIQ coastal-conditions (your-contact@example.com)
